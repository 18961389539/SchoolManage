{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "School": {
    "Database": {
      "BusyTimeoutSeconds": 15
    },
    "Logs": {
      "MinimumLevel": "Information",
      "RetentionDays": 14,
      "MaxFileBytes": 10485760,
      "MaxTotalBytes": 209715200
    },
    "Backups": {
      "Directory": "",
      "RetentionCount": 20,
      "MaxTotalBytes": 5368709120,
      "MinimumFreeBytes": 268435456,
      "Automatic": {
        "Enabled": true,
        "TimeOfDay": "02:30"
      }
    },
    "Session": {
      "AbsoluteHours": 24
    },
    "Audits": {
      "RetentionDays": 0,
      "CleanupTimeOfDay": "03:30"
    },
    "Migrations": {
      "PreMigrationBackupCount": 5
    }
  }
}
