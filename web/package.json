{
  "name": "school-training-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:time": "node scripts/check-time.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:ui": "node ../tests/ui/run.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "element-plus": "^2.11.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.12",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.1.1"
  }
}
